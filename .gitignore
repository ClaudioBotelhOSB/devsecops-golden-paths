# ============================================================
# .gitignore - devsecops-golden-paths
# ============================================================

# ─── Terraform ───────────────────────────────────────────────
# Provider binaries and plugin cache (can be huge, OS-specific)
terraform/.terraform/
**/.terraform/providers/
**/.terraform/plugins/
# Terraform state files (contain secrets - NEVER commit)
*.tfstate
*.tfstate.backup
*.tfstate.*.backup
# Terraform plan output
*.tfplan
*.tfplan.json
# Terraform crash log
crash.log
crash.*.log
# Override files (local developer overrides)
override.tf
override.tf.json
*_override.tf
*_override.tf.json
# Terraform vars with sensitive data
*.auto.tfvars
# We DO track: .terraform.lock.hcl (dependency lock)

# ─── Go ──────────────────────────────────────────────────────
# Build output
/bin/
/dist/
*.exe
*.test
*.out
# Coverage
coverage.out
coverage.html
# Vendor (only if not vendoring intentionally)
# vendor/

# ─── Node / Playwright ───────────────────────────────────────
node_modules/
dist/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
playwright-report/
test-results/

# ─── Dart / Flutter (patrol tests) ──────────────────────────
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
build/
*.g.dart
patrol_test_results/

# ─── Docker ──────────────────────────────────────────────────
# (Dockerfile is tracked; ignore build cache markers)
.dockerignore.local

# ─── IDE / Editor ────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# ─── Secrets & credentials ───────────────────────────────────
*.pem
*.key
*.crt
*.p12
*.pfx
.env
.env.*
!.env.example
secrets/
kubeconfig
kubeconfig.*

# ─── OS ──────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

# ─── Misc ────────────────────────────────────────────────────
*.log
*.tmp
*.bak
.cache/
